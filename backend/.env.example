# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env inside the backend directory:
#   cp .env.example .env
# DO NOT commit real credentials or .env files to Git.

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=mongodb://localhost:27017/portfolio_db
# Example for MongoDB Atlas:
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio_db?retryWrites=true&w=majority

# --- Authentication & Security ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_key

# Initial Admin Seeding (for initial bootstrap)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=your_initial_admin_password

# --- Security & Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Media & Image Storage (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- Email Notifications (SMTP / Nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Portfolio Notifications <noreply@example.com>"
NOTIFICATION_EMAIL=admin@example.com
